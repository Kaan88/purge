+fn rev10_show(tag: &str, world: &World, place: &Place) {
+    let found: Vec<_> = decided(world)
+        .into_iter()
+        .filter(|(c, ..)| touches(c, place))
+        .collect();
+    if found.is_empty() {
+        println!("PROBE {tag}: nothing offered");
+    }
+    for (c, band, ticked) in found {
+        let tiers: Vec<String> = c
+            .evidence
+            .iter()
+            .map(|e| format!("{:?}:{:?}", e.kind, e.tier))
+            .collect();
+        println!(
+            "PROBE {tag}: {} {:?} {:?} -> {band:?} ticked={ticked} [{}]",
+            c.scanner,
+            c.action,
+            c.target,
+            tiers.join(", ")
+        );
+    }
+}
+
+fn rev10_place(what: &str, name: &str) -> Place {
+    places()
+        .into_iter()
+        .find(|p| p.what == what && p.name == name)
+        .unwrap()
+}
