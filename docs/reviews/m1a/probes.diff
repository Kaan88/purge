+#[test]
+fn rev10_probe_text_after_path() {
+    let app = app_dir();
+    let exe = format!(r"{FIREFOX}\firefox.exe");
+    let foreign = rev10_place("foreign key", "SearchPath");
+    for text in [
+        format!(r"{app}\x.exe|user text"),
+        format!(r"{app}|user text"),
+        format!(r"{app}\x.exe?a=b"),
+        format!(r"{app}\x.exe*user"),
+        format!(r"{app}\x.exe<user>"),
+        format!(r"{app}\x.exe=user"),
+        format!(r"{app}\x.exe|\Users\tester\tool.exe"),
+        format!(r"{exe}|{}", r"Users\tester\tool.exe"),
+        format!(r"{app}\cmd user text"),
+        format!(r"{app}\readme.txt user text"),
+        format!("{app}\u{a0}user text"),
+    ] {
+        for record in [Record::Value, Record::Snapshot] {
+            let w = world(&foreign, &Data::Sz(text.clone()), record);
+            rev10_show(&format!("after-path {text:?} {record:?}"), &w, &foreign);
+        }
+    }
+    let env = rev10_place("environment, machine", "FX_HOME");
+    for text in [format!(r"{app}\x.exe|user text"), format!(r"{app}|user text")] {
+        let w = world(&env, &Data::Sz(text.clone()), Record::Value);
+        rev10_show(&format!("env {text:?}"), &w, &env);
+    }
+}
