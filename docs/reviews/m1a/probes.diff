+#[test]
+fn rev10_probe_named_after_app() {
+    let app = app_dir();
+    let exe = format!(r"{FIREFOX}\firefox.exe");
+    let hostile = format!(r#""{TOOL}" --with "{app}\x.exe""#);
+    let names: Vec<String> = vec![
+        exe.clone(),
+        format!("{exe} user text"),
+        format!("{exe};{TOOLS}"),
+        format!(r"{TOOLS}\{HASH}\notes.txt"),
+        format!("my {HASH} thing"),
+        "firefox.exe".to_owned(),
+        format!(r"{TOOLS}\firefox.exe"),
+    ];
+    for name in names {
+        let leaked: &'static str = Box::leak(name.clone().into_boxed_str());
+        for (what, key) in [
+            ("foreign key", r"HKLM\SOFTWARE\Other Vendor\Tool".to_owned()),
+            ("Run", format!(r"HKLM\SOFTWARE\{CV}\Run")),
+        ] {
+            let place = Place {
+                what,
+                key: key.clone(),
+                plan_key: key,
+                name: leaked,
+            };
+            for record in [Record::Value, Record::None] {
+                let w = world(&place, &Data::Sz(hostile.clone()), record);
+                rev10_show(&format!("name {name:?} in {what} {record:?}"), &w, &place);
+            }
+        }
+    }
+}
