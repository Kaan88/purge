+#[test]
+fn rev10_probe_nul_and_binary() {
+    use purge_source::types::{REG_BINARY, REG_NONE, REG_SZ, RegData};
+    let app = app_dir();
+    let utf16 = |s: &str| -> Vec<u8> { s.encode_utf16().flat_map(u16::to_le_bytes).collect() };
+    let foreign = rev10_place("foreign key", "SearchPath");
+    // REG_SZ whose bytes hold a second string after a NUL.
+    let mut w = world(&foreign, &Data::Sz(app.clone()), Record::Value);
+    w.fixture.set_value(
+        &foreign.key,
+        foreign.name,
+        RegData::new(REG_SZ, utf16(&format!("{app}\0{TOOLS}\0"))),
+    );
+    rev10_show("REG_SZ with NUL then foreign", &w, &foreign);
+    // Binary / none data holding foreign text, value named by a bare exe name / plain name.
+    for ty in [REG_BINARY, REG_NONE] {
+        for name in ["firefox.exe", "SearchPath"] {
+            let place = Place {
+                what: "foreign key",
+                key: foreign.key.clone(),
+                plan_key: foreign.plan_key.clone(),
+                name: if name == "firefox.exe" { "firefox.exe" } else { "SearchPath" },
+            };
+            let mut w = world(&place, &Data::Sz(app.clone()), Record::Value);
+            w.fixture.set_value(
+                &place.key,
+                place.name,
+                RegData::new(ty, utf16(&format!("\"{TOOL}\" --with \"{app}\\x.exe\"\0"))),
+            );
+            rev10_show(&format!("type {ty} name {name}"), &w, &place);
+        }
+    }
+}
