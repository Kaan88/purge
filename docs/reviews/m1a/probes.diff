+#[test]
+fn rev10_probe_recall() {
+    let exe = format!(r"{FIREFOX}\firefox.exe");
+    let foreign = rev10_place("foreign key", "SearchPath");
+    let run = rev10_place("Run", "Agent");
+    let env = rev10_place("environment, machine", "FX_HOME");
+    for (place, text) in [
+        (&foreign, format!(r#""{exe}" /setup"#)),
+        (&foreign, format!(r#""{exe}""#)),
+        (&env, format!(r#""{exe}" -multiInst"#)),
+        (&run, format!(r#"rundll32.exe "{FIREFOX}\x.dll",Start"#)),
+        (&run, format!(r#"cmd.exe /c start "" "{exe}""#)),
+    ] {
+        let w = world(place, &Data::Sz(text.clone()), Record::Value);
+        rev10_show(&format!("recall {} {text:?}", place.what), &w, place);
+    }
