+#[test]
+fn rev10_probe_who_offers() {
+    use std::collections::BTreeMap;
+    let mut per: BTreeMap<String, usize> = BTreeMap::new();
+    let mut per_place: BTreeMap<&'static str, usize> = BTreeMap::new();
+    for place in places() {
+        for data in hostile() {
+            for record in RECORDS {
+                if own_by_record(&place, record)
+                    || (place.commands() && matches!(data, Data::NotACommand(_)))
+                {
+                    continue;
+                }
+                for (c, ..) in decided(&world(&place, &data, record)) {
+                    if touches(&c, &place) {
+                        *per.entry(c.scanner.clone()).or_default() += 1;
+                        *per_place.entry(place.what).or_default() += 1;
+                    }
+                }
+            }
+        }
+    }
+    println!("PROBE offering per scanner: {per:?}");
+    println!("PROBE offering per place: {per_place:?}");
+}
