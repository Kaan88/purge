+#[test]
+fn rev10_probe_co_removed_through_run() {
+    use purge_model::Tier;
+    use purge_scan::framework::AppIdentityView;
+    let key = r"HKLM\SOFTWARE\Other Vendor\Tool";
+    let svc = format!(r"{MAINTENANCE}\maintenanceservice.exe");
+    let target = value(key, "Updater");
+    let mut fp = firefox();
+    {
+        let co = fp.co_removed[0].fingerprint.as_mut().unwrap();
+        co.inno.push(inno(InnoRecordKind::RegDeleteValue, target.clone()));
+        co.ref_snapshot.push(snap(
+            target.clone(),
+            RefCarrier::Data,
+            purge_model::AnchorKind::Root,
+            MAINTENANCE,
+        ));
+    }
+    let world = World::new(machine().sz(key, "Updater", &svc), fp);
+    let app = AppIdentityView::from_fingerprint(&world.fp, &world.env);
+    for scanner in catalog::all_scanners() {
+        let direct = scanner.scan(&world.ctx(), &app);
+        let driven = world.ctx().run(scanner.as_ref(), &app);
+        for (d, r) in direct.iter().zip(&driven) {
+            if d.target != target {
+                continue;
+            }
+            let a = |c: &Candidate| c.evidence.iter().filter(|e| e.tier == Tier::A).count();
+            println!(
+                "PROBE co-removed {}: owner {:?} scan tierA={} run tierA={} run-evidence={:?}",
+                d.scanner,
+                d.owner.display_name,
+                a(d),
+                a(r),
+                r.evidence
+                    .iter()
+                    .map(|e| (e.tier, e.detail.get("unproven").map(|s| s.to_string())))
+                    .collect::<Vec<_>>()
+            );
+        }
+    }
+}
