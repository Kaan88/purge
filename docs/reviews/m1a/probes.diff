+#[test]
+fn rev10_probe_command_slash() {
+    let exe = format!(r"{FIREFOX}\firefox.exe");
+    for what in ["Run", "Run, user", "shell verb"] {
+        let name = if what == "shell verb" { "" } else { "Agent" };
+        let run = rev10_place(what, name);
+        for text in [
+            format!(r"{exe}/../../../Users/tester/tool.exe --x"),
+            format!(r"{FIREFOX}\run.cmd/../../Users/tester/tool.exe"),
+            format!(r#""{exe}/../../../Users/tester/tool.exe" --x"#),
+            format!(r#"{exe}"{TOOL}""#),
+        ] {
+            let w = world(&run, &Data::Sz(text.clone()), Record::Value);
+            rev10_show(&format!("cmd {what} {text:?}"), &w, &run);
+        }
+    }
+}
