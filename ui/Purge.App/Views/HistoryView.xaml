<?xml version="1.0" encoding="utf-8"?>
<!-- S4: history and undo ("4 · History & undo" artboard, "Time scrubber" without the drag marker), with the board 13
     timeline above the list. History is the list of events (what happened); the Quarantine page is the storage. The
     timeline is only a way to move through the list: selecting a marker selects that cleanup below. It is a
     horizontal virtualized ListView, so hundreds of cleanups stay cheap. Data: history.index on the medium engine;
     "Show items" (history.get) and Restore (undo.run) start the broker on the click (design 6.3). -->
<UserControl
    x:Class="Purge.App.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Purge.App.Views">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="History &amp; undo" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Files can be put back for 30 days, registry and task backups for 180 days" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- journal.pending starts the broker, so only on this click (design 6.3), never on page open. -->
                <Button x:Name="CheckInterrupted" Content="Check for interrupted cleanups" Style="{StaticResource SubtleButton}"
                        Click="OnCheckInterrupted" />
                <Button Content="Open quarantine" Style="{StaticResource SubtleButton}" Click="OnOpenVault" />
            </StackPanel>
        </Grid>
        <StackPanel x:Name="InfoBarHost" Grid.Row="1" Spacing="6" />

        <!-- Loading, empty and error states take the place of the timeline and the list. -->
        <StackPanel x:Name="StatePanel" Grid.Row="2" Grid.RowSpan="2" Spacing="6" Padding="4,24" HorizontalAlignment="Center"
                    VerticalAlignment="Top" MaxWidth="520">
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28" />
            <TextBlock x:Name="StateTitle" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="StateDetail" Style="{StaticResource Body13}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="StateRetry" Content="Try again" HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnRetryLoad" Visibility="Collapsed" />
        </StackPanel>

        <!-- Board 13: timeline strip -->
        <Border x:Name="StripCard" Grid.Row="2" Style="{StaticResource Card}" Padding="6,4">
            <ListView x:Name="Strip" SelectionMode="Single" SelectionChanged="OnStripSelectionChanged" Height="78"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Timeline of cleanups">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryRow">
                        <Grid Width="{x:Bind MarkWidth}" Height="68" AutomationProperties.Name="{x:Bind MarkName}">
                            <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <!-- The line of time, with a dot per cleanup; day items start a new day. -->
                            <Border Height="2" Margin="-8,0" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Ellipse Width="10" Height="10" HorizontalAlignment="Left" Visibility="{x:Bind OpVisibility}"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
                            <Border Width="2" Height="18" HorizontalAlignment="Left" Visibility="{x:Bind DayVisibility}"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                            <TextBlock Grid.Row="1" TextTrimming="CharacterEllipsis" FontSize="12">
                                <Run Text="{x:Bind Title}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Text="{x:Bind MarkRestorable}" FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid x:Name="ListAndDetail" Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6" VerticalAlignment="Top">
                <ListView x:Name="Ops" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="14,0,14,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryRow">
                            <Grid>
                                <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind DayVisibility}" FontSize="12"
                                           Margin="0,10,0,2" Style="{StaticResource SecondaryText}" />
                                <Grid ColumnSpacing="12" Padding="0,12" Visibility="{x:Bind OpVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{x:Bind Tile}">
                                        <TextBlock Text="{x:Bind Initial}" Foreground="White" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <Run Text="{x:Bind Time}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Detail}" FontSize="13" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Border Style="{StaticResource ChipCaution}" Visibility="{x:Bind AlertVisibility}" ToolTipService.ToolTip="{x:Bind AlertTip}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Check items" /></TextBlock></Border>
                                        <Border Style="{StaticResource ChipAttention}" Visibility="{x:Bind UndoableVisibility}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" " /><Run Text="{x:Bind State}" /></TextBlock></Border>
                                        <Border Style="{StaticResource ChipCaution}" Visibility="{x:Bind CautionVisibility}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" " /><Run Text="{x:Bind State}" /></TextBlock></Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind NeutralVisibility}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" " /><Run Text="{x:Bind State}" /></TextBlock></Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DTitle" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="DSummary" Style="{StaticResource Body13}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button x:Name="ShowItems" Content="Show items" Click="OnShowItems" />
                    <Border x:Name="ItemsBorder" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6"
                            Visibility="Collapsed">
                        <ItemsControl x:Name="DItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:HistoryItemRow">
                                    <Grid ColumnSpacing="8" Padding="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <CheckBox IsChecked="{x:Bind Checked, Mode=TwoWay}" IsEnabled="{x:Bind Selectable}" MinWidth="0" Click="OnItemCheck"
                                                  AutomationProperties.Name="{x:Bind Name}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Kind}" FontSize="11" Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Outcome}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                        <!-- S5: what reconcile found in quarantine in this item's place. -->
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="6" Margin="0,2,0,4" Visibility="{x:Bind AlertVisibility}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource GlyphWarn}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Alert}" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource GlyphInfo}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock x:Name="DNote" Grid.Column="1" Style="{StaticResource Body13}" TextWrapping="Wrap"
                                       Text="Undo puts the leftovers back exactly as they were. It doesn't reinstall the program: run its installer for that." />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RestoreSelected" Style="{StaticResource AccentButtonStyle}" Click="OnRestore" Tag="selected" />
                        <Button x:Name="RestoreAll" Content="Restore all" Click="OnRestore" Tag="all" />
                    </StackPanel>
                    <TextBlock x:Name="DExpiry" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
