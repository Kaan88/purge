<?xml version="1.0" encoding="utf-8"?>
<!-- Board 16, Quarantine vault: where moved items wait (the storage). History & undo stays the list of events.
     Use and real cap per drive, days left per cleanup, put back, and delete what is past retention. Data:
     history.index (medium engine); "Put back" is undo.run and "Review and delete" quarantine.expiring and
     quarantine.purge on the broker, each through the broker's security prompt. Expiry only proposes
     (ENGINE_PLAN.md §7.8); there is no "Empty quarantine" in M3 (design 7a page table). "Delete now" (a whole
     cleanup, or one item of the list "Choose items" reads from the broker) is the same two calls before the
     retention ends; the broker's prompt says so and is the confirmation (DECISIONS 2026-11-23). -->
<UserControl
    x:Class="Purge.App.Views.VaultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Purge.App.Views">

    <Grid Padding="28,20,28,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Quarantine" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Where removed leftovers wait. Nothing here is gone until you delete it." Style="{StaticResource SecondaryText}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ReviewButton" Click="OnReviewExpired" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Review and delete expired…" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Capacity per drive: each drive keeps its own quarantine (no cross-volume copies). -->
        <ItemsControl x:Name="Volumes" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:VaultVolume">
                    <Border Style="{StaticResource Card}" Padding="16,12" Width="320" ToolTipService.ToolTip="{x:Bind Tip}">
                        <StackPanel Spacing="6">
                            <TextBlock><Run Text="{x:Bind Volume}" FontSize="20" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind UsedText}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                            <ProgressBar Value="{x:Bind Percent}" Maximum="100" AutomationProperties.Name="{x:Bind Tip}" />
                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource SmallSecondary}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Spacing="10">
            <StackPanel x:Name="InfoBarHost" Spacing="6" />

            <!-- The quarantined items of one cleanup, as the broker listed them, each with its own "Delete now". -->
            <Border x:Name="ItemsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Padding="16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ItemsTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                       Text="Deleting an item here is for good: it cannot be undone, and Undo can no longer put it back. Purge asks in its security prompt first." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Close" Style="{StaticResource SubtleButton}" Click="OnCloseItems" VerticalAlignment="Center"
                                AutomationProperties.Name="Close the item list" />
                    </Grid>
                    <ListView x:Name="Items" Grid.Row="1" SelectionMode="None" MaxHeight="232" Padding="0,0,0,8"
                              AutomationProperties.Name="Quarantined items of the cleanup">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VaultItem">
                                <Grid MinHeight="48" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Path}">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Path}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SmallSecondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Delete now…" Click="OnDeleteItemNow" IsEnabled="{x:Bind CanAct}"
                                            VerticalAlignment="Center" AutomationProperties.Name="{x:Bind DeleteLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="By cleanup" FontWeight="SemiBold" />
                    <TextBlock x:Name="Totals" Grid.Column="1" Style="{StaticResource SmallSecondary}" />
                </Grid>
                <ListView x:Name="Batches" Grid.Row="1" SelectionMode="None" Padding="0,0,0,8"
                          AutomationProperties.Name="Quarantined cleanups">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:VaultBatch">
                            <Grid Height="64" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7" Background="{x:Bind TileBrush}">
                                    <TextBlock Text="{x:Bind Initial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{x:Bind Name}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{x:Bind When}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                    <TextBlock Text="{x:Bind Summary}" FontSize="13" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SmallSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <!-- State: chip with its own glyph -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource ChipSuccess}" Visibility="{x:Bind OkVisibility}">
                                        <TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" " /><Run Text="{x:Bind State}" /></TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource ChipCaution}" Visibility="{x:Bind WarnVisibility}">
                                        <TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="{x:Bind WarnGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" " /><Run Text="{x:Bind State}" /></TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Visibility="{x:Bind NeutralVisibility}">
                                        <TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" " /><Run Text="{x:Bind State}" /></TextBlock>
                                    </Border>
                                </StackPanel>
                                <!-- Days left on the files: a determinate ring, with the number written inside. -->
                                <Grid Grid.Column="3" Width="44" Height="44" HorizontalAlignment="Center" Visibility="{x:Bind HeldVisibility}"
                                      ToolTipService.ToolTip="{x:Bind Detail}">
                                    <ProgressRing IsIndeterminate="False" Value="{x:Bind RingValue}" Maximum="100" Width="44" Height="44"
                                                  Background="{ThemeResource ControlFillColorTertiaryBrush}" AutomationProperties.Name="{x:Bind Detail}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DaysText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" LineHeight="14" />
                                        <TextBlock Text="{x:Bind DaysCaption}" FontSize="9" HorizontalAlignment="Center" LineHeight="10" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="{x:Bind RestoreText}" Click="OnRestore" Visibility="{x:Bind HeldVisibility}"
                                            IsEnabled="{x:Bind CanAct, Mode=OneWay}" AutomationProperties.Name="{x:Bind RestoreText}" />
                                    <!-- Before the retention ends too: the broker's prompt names every item and says it is for good. -->
                                    <Button Content="Delete now…" Click="OnDeleteNow" Visibility="{x:Bind DeleteVisibility}"
                                            IsEnabled="{x:Bind CanAct, Mode=OneWay}" AutomationProperties.Name="Delete the files of this cleanup now"
                                            ToolTipService.ToolTip="Delete this cleanup's quarantined files for good, without waiting for the retention to end" />
                                    <Button Content="Choose items…" Style="{StaticResource SubtleButton}" Click="OnChooseItems"
                                            Visibility="{x:Bind ChooseVisibility}" IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                                            AutomationProperties.Name="Choose items to delete now"
                                            ToolTipService.ToolTip="List this cleanup's quarantined items and delete single ones" />
                                    <Button Content="Details" Style="{StaticResource SubtleButton}" Click="OnDetails" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
