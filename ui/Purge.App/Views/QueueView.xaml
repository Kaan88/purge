<?xml version="1.0" encoding="utf-8"?>
<!-- S2: uninstall queue ("2 · Uninstall queue" artboard). Sample state: Firefox done, Python waiting on a
     running process, Git queued. -->
<UserControl
    x:Class="Purge.App.Views.QueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Tile36" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TileLetter" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Padding="28,20,28,24" Spacing="16">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Uninstall queue" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="3 programs · one at a time · started 04:12" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Pause after current" Click="OnSample" />
                    <Button Content="Cancel remaining" Style="{StaticResource SubtleButton}" Click="OnSample" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="RunningBar" Severity="Warning" IsOpen="True" IsClosable="True"
                     Title="Python is still running."
                     Message="python.exe (2 processes) and its files are in use. Close them so the uninstaller can remove everything.">
                <InfoBar.ActionButton>
                    <Button Content="Close python.exe" Style="{StaticResource AccentButtonStyle}" Click="OnClosePython" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10">
                    <!-- Done -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FirefoxTile" Style="{StaticResource Tile36}"><TextBlock Text="F" Style="{StaticResource TileLetter}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Mozilla Firefox" FontWeight="SemiBold" />
                                <TextBlock Text="Uninstaller finished in 18 s (exit code 0) · verified gone · 12 leftovers, 8 Safe and pre-selected"
                                           Style="{StaticResource SmallSecondary}" FontSize="13" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource ChipSuccess}"><TextBlock Text="Done" Style="{StaticResource ChipTextPrimary}" /></Border>
                            <Button Grid.Column="3" Content="Review leftovers" Style="{StaticResource AccentButtonStyle}" Click="OnReview" />
                        </Grid>
                    </Border>

                    <!-- Active -->
                    <Border Style="{StaticResource Card}" Padding="18,16" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PythonTile" Style="{StaticResource Tile36}"><TextBlock Text="P" Style="{StaticResource TileLetter}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Python 3.12.7 (64-bit)" FontWeight="SemiBold" />
                                    <TextBlock FontSize="13" Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                        <Run Text="Burn bundle · quiet mode: " />
                                        <Run Text="python-3.12.7-amd64.exe /uninstall /quiet" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </TextBlock>
                                </StackPanel>
                                <Border x:Name="PythonState" Grid.Column="2" Style="{StaticResource ChipAttention}">
                                    <TextBlock x:Name="PythonStateText" Text="Waiting for you" Style="{StaticResource ChipTextPrimary}" />
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="PythonProgress" Value="40" Maximum="100" AutomationProperties.Name="Python uninstall progress" />
                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Style="{StaticResource GlyphDone}" />
                                    <TextBlock Text="Record what Python registered · 412 entries" Style="{StaticResource StepText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Style="{StaticResource GlyphDone}" />
                                    <TextBlock Text="Read its installer records (Burn bundle, 12 MSI packages)" Style="{StaticResource StepText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="CloseAppsWarn" Style="{StaticResource GlyphWarn}" />
                                    <FontIcon x:Name="CloseAppsDone" Style="{StaticResource GlyphDone}" Visibility="Collapsed" />
                                    <TextBlock Text="Close running apps" Style="{StaticResource StepText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Style="{StaticResource GlyphPending}" />
                                    <TextBlock Text="Run its uninstaller" Style="{StaticResource StepText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Style="{StaticResource GlyphPending}" />
                                    <TextBlock Text="Check it's really gone" Style="{StaticResource StepText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon Style="{StaticResource GlyphPending}" />
                                    <TextBlock Text="Find leftovers" Style="{StaticResource StepText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Queued -->
                    <Border x:Name="GitCard" Style="{StaticResource Card}" Padding="18,16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GitTile" Style="{StaticResource Tile36}"><TextBlock Text="G" Style="{StaticResource TileLetter}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Git" FontWeight="SemiBold" />
                                <TextBlock Text="Inno Setup · quiet mode: /VERYSILENT /NORESTART" Style="{StaticResource SmallSecondary}" FontSize="13" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Chip}"><TextBlock Text="Queued" Style="{StaticResource ChipText}" /></Border>
                            <Button Grid.Column="3" Content="Remove" Style="{StaticResource SubtleButton}"
                                    AutomationProperties.Name="Remove Git from queue" Click="OnRemoveGit" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Safety net -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Safety net" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource GlyphDone}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Restore point created at 04:12" FontSize="13" />
                                <TextBlock Text="&quot;Purge: before removing 3 programs&quot;" Style="{StaticResource SmallSecondary}" FontSize="13" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource GlyphDone}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Leftovers go to quarantine first" FontSize="13" />
                                <TextBlock Text="Undo any time in History for 30 days" Style="{StaticResource SmallSecondary}" FontSize="13" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <TextBlock Text="Use quiet mode when available" VerticalAlignment="Center" />
                            <ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Use quiet mode when available" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Scan for leftovers after each" VerticalAlignment="Center" />
                            <ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Scan for leftovers after each" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Restart later if needed" VerticalAlignment="Center" />
                            <ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Restart later if needed" />
                        </Grid>
                        <TextBlock Style="{StaticResource SmallSecondary}"
                                   Text="The admin prompt appeared once, when you clicked Uninstall. Purge's elevated helper closes when the queue is done." />
                        <TextBlock Style="{StaticResource SmallSecondary}"
                                   Text="Quiet mode skips the program's own dialogs. Purge never answers &quot;Keep my settings?&quot; questions for you in interactive mode." />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource SmallSecondary}" Text="Sample data: the engine is not connected in this preview." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
