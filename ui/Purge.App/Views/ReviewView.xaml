<?xml version="1.0" encoding="utf-8"?>
<!-- S3: leftover review, the core screen (board "03 Leftovers, refined"; ENGINE_PLAN.md §9.4). A verdict card on
     top, then a flattened, virtualized ListView with group header rows; every path shows its reason underneath, so
     the "why" card is rarely needed. Group checkboxes toggle Safe items only (S19). -->
<UserControl
    x:Class="Purge.App.Views.ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Purge.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="28,20,28,12" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="AppTile" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center">
                    <TextBlock Text="F" Foreground="White" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Leftovers of Mozilla Firefox" FontSize="24" LineHeight="30" FontWeight="SemiBold" />
                    <TextBlock Text="Uninstalled 04:14 · scanned in 1.4 s · restorable for 30 days" FontSize="13" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="ExpandButton" Content="Collapse all" Style="{StaticResource SubtleButton}" Click="OnExpandAll" />
                    <Button x:Name="WeakButton" Style="{StaticResource SubtleButton}" Click="OnToggleWeak" />
                    <DropDownButton x:Name="SelectButton" Content="Select: Safe only" Background="Transparent" BorderThickness="0">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Safe only" Tag="safe" Click="OnSelectPreset" />
                                <MenuFlyoutItem Text="Safe and Likely, no user data" Tag="likely" Click="OnSelectPreset" />
                                <MenuFlyoutItem Text="Nothing" Tag="none" Click="OnSelectPreset" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="InfoBarHost" Spacing="6" />

            <!-- Verdict: what is ready to move, and how the candidates split by rating. -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="READY TO MOVE" FontSize="11" CharacterSpacing="50" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="VerdictText" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Grid x:Name="BandBar" Height="10" CornerRadius="5" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BarSafe" />
                                <ColumnDefinition x:Name="BarLikely" />
                                <ColumnDefinition x:Name="BarProtected" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SystemFillColorSuccessBrush}" />
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCautionBrush}" />
                            <Border Grid.Column="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock FontSize="13"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /><Run Text="  " /><Run x:Name="SafePill" /></TextBlock>
                            <TextBlock FontSize="13"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource SystemFillColorCautionBrush}" /><Run Text="  " /><Run x:Name="LikelyPill" /></TextBlock>
                            <TextBlock FontSize="13"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" /><Run Text="  " /><Run x:Name="ProtectedPill" /></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6">
              <Grid x:Name="ListHost" SizeChanged="OnListHostSizeChanged">
                <ListView x:Name="Items" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="10,2,12,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LeftoverRow">
                            <Grid>
                                <!-- Group header -->
                                <Grid Height="44" ColumnSpacing="10" Visibility="{x:Bind GroupVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        <ColumnDefinition /><ColumnDefinition Width="120" /><ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SubtleButton}" Padding="4" MinHeight="0" Click="OnToggleGroup"
                                            AutomationProperties.Name="{x:Bind GroupName}">
                                        <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="12" />
                                    </Button>
                                    <CheckBox Grid.Column="1" IsChecked="{x:Bind GroupChecked, Mode=OneWay}" IsThreeState="False" MinWidth="0"
                                              Click="OnGroupCheck" AutomationProperties.Name="{x:Bind GroupName}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                        <Run Text="{x:Bind GroupName}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind CountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <!-- How much of the group is selected. -->
                                    <Grid Grid.Column="4" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                          ToolTipService.ToolTip="{x:Bind GroupBarTip, Mode=OneWay}">
                                        <Rectangle Width="{x:Bind GroupBarWidth, Mode=OneWay}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="5" Text="{x:Bind GroupSizeText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryText}" />
                                </Grid>
                                <!-- Candidate -->
                                <Grid Padding="34,4,0,4" ColumnSpacing="8" Visibility="{x:Bind ItemVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Checked, Mode=OneWay}" MinWidth="0" Click="OnItemCheck"
                                              Visibility="{x:Bind CheckVisibility}" AutomationProperties.Name="{x:Bind Path}" />
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind LockVisibility}"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{x:Bind PathOpacity}">
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Why}" FontSize="12" LineHeight="16" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                    <Grid Grid.Column="2">
                                        <Border Style="{StaticResource ChipSuccess}" Visibility="{x:Bind SafeVisibility}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Safe" /></TextBlock></Border>
                                        <Border Style="{StaticResource ChipCaution}" Visibility="{x:Bind LikelyVisibility}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Likely" /></TextBlock></Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind WeakVisibility}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Weak" /></TextBlock></Border>
                                        <Border Style="{StaticResource ChipOutline}" Visibility="{x:Bind ProtectedVisibility}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Protected" /></TextBlock></Border>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Board 22: one "Ask" button that follows the selected row (it is not part of the row template).
                     Loaded only when Settings → Assistant → "Show Ask in review lists" is on. -->
                <Canvas x:Name="AskLayer" x:Load="False">
                    <Button x:Name="AskButton" Height="28" Padding="10,0" MinWidth="0" Click="OnAsk" Visibility="Collapsed"
                            AutomationProperties.Name="Ask the assistant about this item">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="12" Height="12" Data="M7,0 L8.5,5.3 L14,7 L8.5,8.6 L7,14 L5.5,8.6 L0,7 L5.5,5.3 Z" />
                            <TextBlock Text="Ask" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TeachingTip x:Name="AskTip" PreferredPlacement="Bottom" IsLightDismissEnabled="True"
                                 ActionButtonClick="OnAskAction" CloseButtonContent="Keep as is">
                        <StackPanel Spacing="10" MaxWidth="320">
                            <TextBlock x:Name="AskQuestion" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="AskAnswer" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock x:Name="AskChecked" TextWrapping="Wrap" Style="{StaticResource SmallSecondary}" />
                            <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap">
                                <Run Text="&#xE946;" FontFamily="Segoe Fluent Icons" /><Run Text="  Suggests and explains only; it never deletes. Sample answer: the assistant isn't connected yet." />
                            </TextBlock>
                        </StackPanel>
                    </TeachingTip>
                </Canvas>
              </Grid>
            </Border>

            <!-- Why this item -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Selected item" FontSize="12" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="DPath" Style="{StaticResource Mono}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="DSafe" Style="{StaticResource ChipSuccess}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Safe" /></TextBlock></Border>
                            <Border x:Name="DLikely" Style="{StaticResource ChipCaution}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Likely" /></TextBlock></Border>
                            <Border x:Name="DWeak" Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Weak" /></TextBlock></Border>
                            <Border x:Name="DProtected" Style="{StaticResource ChipOutline}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Protected" /></TextBlock></Border>
                            <Border x:Name="DUserData" Style="{StaticResource ChipCritical}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" User data" /></TextBlock></Border>
                            <TextBlock x:Name="DPreselect" FontSize="13" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <TextBlock Text="Evidence" FontWeight="SemiBold" FontSize="13" />
                        <ItemsControl x:Name="DEvidence">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:EvidenceLine">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Glyph}" Foreground="{x:Bind GlyphBrush}" FontSize="13" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" Style="{StaticResource Body13}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Divider}" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Contents" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DContents" Grid.Column="1" Style="{StaticResource Body13}" />
                            <TextBlock Grid.Row="1" Text="If removed" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DIfRemoved" Grid.Row="1" Grid.Column="1" Style="{StaticResource Body13}" />
                            <TextBlock Grid.Row="2" Text="Found by" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DFoundBy" Grid.Row="2" Grid.Column="1" Style="{StaticResource Body13}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open folder" Click="OnSample" />
                            <Button Content="Always keep" Style="{StaticResource SubtleButton}" Click="OnSample" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="28,12" ColumnSpacing="12" Background="{ThemeResource FooterBarBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run x:Name="FooterCount" FontWeight="SemiBold" />
                <Run x:Name="FooterDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
            <TextBlock Grid.Column="1" Text="You'll confirm in the Purge security prompt" FontSize="12" VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}" />
            <Button Grid.Column="2" Content="Skip" Click="OnSkip" />
            <Button x:Name="MoveButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnMove">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                    <TextBlock x:Name="MoveText" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
