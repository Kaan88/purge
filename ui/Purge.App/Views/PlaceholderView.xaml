<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in for a screen that is not built yet. Created on first navigation, never at launch. -->
<UserControl
    x:Class="Purge.App.Views.PlaceholderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="8" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="ScreenText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,16,0,0" Padding="20" ColumnSpacing="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="GlyphIcon" FontSize="28" VerticalAlignment="Top"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                    <TextBlock x:Name="PointsText" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
