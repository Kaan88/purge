<?xml version="1.0" encoding="utf-8"?>
<!-- S3: the leftovers review (design 7a, 9.4), its waiting state and its result page. One flattened,
     virtualized ListView holds the eight groups as header rows; the broker's plan drives the ticks and
     plan.execute drives the result. Nothing is said to be moved before the result arrives. -->
<UserControl
    x:Class="Purge.App.Views.LeftoversView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Purge.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Padding="28,20,28,12" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="AppTile" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center">
                    <TextBlock x:Name="AppInitial" Text="F" Foreground="White" FontWeight="SemiBold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Leftovers" FontSize="24" LineHeight="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" FontSize="13" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="ExpandButton" Content="Collapse all" Style="{StaticResource SubtleButton}" Click="OnExpandAll" />
                    <Button x:Name="WeakButton" Style="{StaticResource SubtleButton}" Click="OnToggleWeak" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="InfoBarHost" Spacing="6" />
        </StackPanel>

        <!-- Review -->
        <Grid x:Name="ReviewPanel" Grid.Row="1" Padding="28,0,28,12" ColumnSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Verdict: what is ready to move, and how the candidates split by rating. -->
            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="READY TO MOVE" FontSize="11" CharacterSpacing="50" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="VerdictText" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Grid Height="10" CornerRadius="5" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BarSafe" />
                                <ColumnDefinition x:Name="BarLikely" />
                                <ColumnDefinition x:Name="BarProtected" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SystemFillColorSuccessBrush}" />
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCautionBrush}" />
                            <Border Grid.Column="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock FontSize="13"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /><Run Text="  " /><Run x:Name="SafePill" /></TextBlock>
                            <TextBlock FontSize="13"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource SystemFillColorCautionBrush}" /><Run Text="  " /><Run x:Name="LikelyPill" /></TextBlock>
                            <TextBlock FontSize="13"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" /><Run Text="  " /><Run x:Name="ProtectedPill" /></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <ListView x:Name="Items" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="10,2,12,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LeftoversRow">
                            <Grid>
                                <!-- Group header -->
                                <Grid Height="44" ColumnSpacing="10" Visibility="{x:Bind GroupVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        <ColumnDefinition /><ColumnDefinition Width="120" /><ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SubtleButton}" Padding="4" MinHeight="0" Click="OnToggleGroup"
                                            AutomationProperties.Name="{x:Bind GroupName}">
                                        <FontIcon Glyph="{x:Bind Chevron}" FontSize="12" />
                                    </Button>
                                    <CheckBox Grid.Column="1" IsChecked="{x:Bind GroupChecked, Mode=OneWay}" IsThreeState="False"
                                              MinWidth="0" Click="OnGroupCheck" Visibility="{x:Bind GroupTickVisibility}"
                                              AutomationProperties.Name="{x:Bind GroupName}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                        <Run Text="{x:Bind GroupName}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <Grid Grid.Column="4" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                          Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                          ToolTipService.ToolTip="{x:Bind GroupBarTip}">
                                        <Rectangle Width="{x:Bind GroupBarWidth}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="5" Text="{x:Bind GroupSizeText}" FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                </Grid>
                                <!-- Candidate -->
                                <Grid Padding="34,4,0,4" ColumnSpacing="8" Visibility="{x:Bind ItemVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Checked, Mode=OneWay}" MinWidth="0" Click="OnItemCheck"
                                              Visibility="{x:Bind CheckVisibility}" AutomationProperties.Name="{x:Bind Title}" />
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind LockVisibility}"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{x:Bind PathOpacity}"
                                                ToolTipService.ToolTip="{x:Bind RawTip}" AutomationProperties.Name="{x:Bind Title}">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind RawVisibility}" />
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind LabelVisibility}" />
                                        <TextBlock Text="{x:Bind Location}" FontSize="12" LineHeight="16" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SecondaryText}" Visibility="{x:Bind LabelVisibility}" />
                                        <TextBlock Text="{x:Bind Why}" FontSize="12" LineHeight="16" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{x:Bind RefusalText}" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   Visibility="{x:Bind RefusedVisibility}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind WarningText}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   Visibility="{x:Bind WarningVisibility}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Style="{StaticResource ChipSuccess}" Visibility="{x:Bind SafeVisibility}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Safe" /></TextBlock></Border>
                                        <Border Style="{StaticResource ChipCaution}" Visibility="{x:Bind LikelyVisibility}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Likely" /></TextBlock></Border>
                                        <Border Style="{StaticResource Chip}" Visibility="{x:Bind WeakVisibility}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Weak" /></TextBlock></Border>
                                        <Border Style="{StaticResource ChipOutline}" Visibility="{x:Bind ProtectedVisibility}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Protected" /></TextBlock></Border>
                                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Visibility="{x:Bind AttentionVisibility}" ToolTipService.ToolTip="Needs attention in the security prompt" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Why this item -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Selected item" FontSize="12" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="DTitle" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DPath" Style="{StaticResource Mono}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="DSafe" Style="{StaticResource ChipSuccess}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Safe" /></TextBlock></Border>
                            <Border x:Name="DLikely" Style="{StaticResource ChipCaution}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Likely" /></TextBlock></Border>
                            <Border x:Name="DWeak" Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Weak" /></TextBlock></Border>
                            <Border x:Name="DProtected" Style="{StaticResource ChipOutline}"><TextBlock Style="{StaticResource ChipText}"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" Protected" /></TextBlock></Border>
                            <Border x:Name="DUserData" Style="{StaticResource ChipCritical}"><TextBlock Style="{StaticResource ChipTextPrimary}"><Run Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="10" /><Run Text=" User data" /></TextBlock></Border>
                            <TextBlock x:Name="DPreselect" FontSize="13" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <TextBlock x:Name="DRefused" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="Evidence" FontWeight="SemiBold" FontSize="13" />
                        <ItemsControl x:Name="DEvidence">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:EvidenceLine">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Glyph}" Foreground="{x:Bind GlyphBrush}" FontSize="13" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Divider}" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Contents" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DContents" Grid.Column="1" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="If removed" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DIfRemoved" Grid.Row="1" Grid.Column="1" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Found by" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="DFoundBy" Grid.Row="2" Grid.Column="1" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock x:Name="DOwner" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Waiting: plan.create / plan.execute (the broker's dialog is up) -->
        <Grid x:Name="WaitingPanel" Grid.Row="1" Visibility="Collapsed" Padding="28,0,28,12">
            <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="720">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="42" Height="42" HorizontalAlignment="Center" />
                    <TextBlock x:Name="WaitingTitleText" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WaitingDetailText" Style="{StaticResource SecondaryText}" FontSize="13" TextAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="16,10"
                            HorizontalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CODE IN THE SECURITY PROMPT" FontSize="11" CharacterSpacing="50"
                                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="WaitingCodeText" FontSize="28" FontFamily="Consolas" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Nothing has been moved yet." FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Expander x:Name="AttentionExpander" Header="Items that need attention" HorizontalAlignment="Stretch"
                              IsExpanded="True" Visibility="Collapsed">
                        <ItemsControl x:Name="AttentionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:AttentionModel">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ReasonsText}" FontSize="12" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="12" Style="{StaticResource SecondaryText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Result (design 6.4) -->
        <Grid x:Name="ResultPanel" Grid.Row="1" Visibility="Collapsed" Padding="28,0,28,12">
            <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top" MaxWidth="820" HorizontalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="ResultIcon" Glyph="&#xE73E;" FontSize="28"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResultTitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ResultDetailText" FontSize="14" TextWrapping="Wrap" />
                    <!-- "Delete instead of keeping in quarantine": what became of the second step (DECISIONS 2026-11-24). -->
                    <TextBlock x:Name="DeleteAfterResultText" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="RestorePointText" FontSize="13" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />

                    <StackPanel x:Name="HeldHost" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="Held — in use by another process" FontWeight="SemiBold" FontSize="14" />
                        <ItemsControl x:Name="HeldList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="FailedHost" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="Not moved" FontWeight="SemiBold" FontSize="14" />
                        <ItemsControl x:Name="FailedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="UndoAllButton" Content="Undo all" Click="OnUndoAll" />
                        <Button x:Name="RetryHeldButton" Content="Try the held items again" Click="OnRetryHeld" />
                        <Button x:Name="DoneButton" Content="Done" Style="{StaticResource AccentButtonStyle}" Click="OnDone" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Undone -->
        <Grid x:Name="UndonePanel" Grid.Row="1" Visibility="Collapsed" Padding="28,0,28,12">
            <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top" MaxWidth="820" HorizontalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="UndoTitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="UndoDetailText" FontSize="14" TextWrapping="Wrap" />
                    <ItemsControl x:Name="ConflictList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource Body13}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Done" Style="{StaticResource AccentButtonStyle}" Click="OnDone" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Empty -->
        <Grid x:Name="EmptyPanel" Grid.Row="1" Padding="28,0,28,12">
            <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="EmptyTitle" Text="No scan yet" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="Start an uninstall, or check a program for what it left behind. Purge shows this page after the uninstaller has run." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid x:Name="Footer" Grid.Row="2" Padding="28,12" ColumnSpacing="12" Background="{ThemeResource FooterBarBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run x:Name="FooterCount" FontWeight="SemiBold" />
                <Run x:Name="FooterDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Secondary on purpose: the default keeps everything in quarantine. A request only; the broker moves
                     first and asks in a second prompt of its own before it deletes anything (DECISIONS 2026-11-24). -->
                <CheckBox x:Name="DeleteAfterBox" MinWidth="0" FontSize="12" VerticalAlignment="Center" Click="OnDeleteAfter" />
                <TextBlock Text="You'll confirm in the Purge security prompt" FontSize="12" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Skip" Click="OnSkip" />
            <Button x:Name="MoveButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnMove">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                    <TextBlock x:Name="MoveText" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
