<?xml version="1.0" encoding="utf-8"?>
<!-- S2: the Uninstall pipeline. Confirm, run the program's own uninstaller on its route, check it is gone, scan, then
     hand the scan to the leftovers page. Everything is filled in from UninstallController; no x:Bind is used, so AOT
     needs no reflection and the page is the same in sample and live builds. -->
<UserControl
    x:Class="Purge.App.Views.UninstallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer AutomationProperties.Name="Uninstall pipeline">
        <StackPanel Padding="28,20,28,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Uninstall pipeline" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="Nothing is running" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border x:Name="RouteChip" Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="RouteText" Style="{StaticResource ChipText}" Text="Waiting" />
                </Border>
            </Grid>

            <!-- The bars of the run: cancelled prompt, exit code, still installed, restart, a link that ended. -->
            <StackPanel x:Name="BarsHost" Spacing="8" />

            <!-- No program yet: a plain empty state instead of a run's cards and safety net. -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Padding="28" HorizontalAlignment="Left" MaxWidth="620">
                <StackPanel Spacing="10">
                    <TextBlock Text="No uninstall yet" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="Choose a program on Programs to uninstall it. Its progress shows here." />
                    <Button Content="Go to Programs" HorizontalAlignment="Left" Click="OnOpenPrograms" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- "Uninstall N" on the Programs page queues the ticked programs; the next one starts when the user asks. -->
            <Border x:Name="NextCard" Style="{StaticResource Card}" Padding="18,14" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="NextText" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="NextDetail" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Click="OnUninstallNext" />
                        <Button x:Name="SkipButton" Content="Skip" Click="OnSkipNext"
                                ToolTipService.ToolTip="Leaves this program installed and moves on to the one after it" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="RunGrid" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProgramTile" Width="36" Height="36" CornerRadius="8">
                                <TextBlock x:Name="ProgramInitial" Text="?" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="ProgramNameText" Text="No program selected" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="RouteDetailText" TextWrapping="Wrap" Style="{StaticResource SmallSecondary}"
                                           Text="Pick a program in Programs and choose Uninstall." />
                                <TextBlock x:Name="CommandText" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed"
                                           AutomationProperties.Name="Uninstaller command" />
                                <TextBlock x:Name="SignerText" Style="{StaticResource SmallSecondary}" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Progress" FontWeight="SemiBold" />
                            <StackPanel x:Name="StepperHost" Spacing="10" />
                        </StackPanel>
                    </Border>

                    <!-- Delta 1: the running-process line is a hint and a Retry, never a "close the app" control. -->
                    <Border x:Name="RunningCard" Style="{StaticResource Card}" Padding="18,16" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Still running" FontWeight="SemiBold" />
                            <TextBlock x:Name="RunningText" Style="{StaticResource Body13}" />
                            <TextBlock Style="{StaticResource SmallSecondary}"
                                       Text="Close it yourself, then check again. Purge never closes a program for you." />
                            <Button x:Name="RunningRetry" Content="Check again" Style="{StaticResource SubtleButton}"
                                    HorizontalAlignment="Left" Click="OnRecheck"
                                    AutomationProperties.Name="Check again for running processes" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Safety net" FontWeight="SemiBold" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Restore point at the cleanup step" FontWeight="SemiBold" FontSize="13" />
                            <ComboBox x:Name="RestorePointBox" HorizontalAlignment="Stretch" SelectionChanged="OnRestorePointChanged"
                                      AutomationProperties.Name="Restore point at the cleanup step" />
                            <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                       Text="Purge makes the restore point just before it moves the leftovers, not before the uninstaller runs." />
                        </StackPanel>

                        <!-- Shown only when the program has a quiet uninstaller; otherwise the note below says why not. -->
                        <Grid x:Name="QuietRow" Visibility="Collapsed">
                            <TextBlock Text="Use quiet mode" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="QuietSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnQuietToggled" AutomationProperties.Name="Use quiet mode" />
                        </Grid>
                        <TextBlock x:Name="QuietNote" Style="{StaticResource SmallSecondary}"
                                   Text="Quiet mode skips the program's own dialogs. Purge never answers &quot;Keep my settings?&quot; for you." />

                        <Border Style="{StaticResource Divider}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Leftovers go to quarantine first" FontSize="13" />
                            <TextBlock Text="Undo any time in History for 30 days" Style="{StaticResource SmallSecondary}" />
                        </StackPanel>

                        <!-- Delta 4: shown only when a restore point was actually made. The uninstall step makes none;
                             the executor does it when the cleanup plan runs, so this line stays collapsed here. -->
                        <Grid x:Name="RestorePointMadeRow" Visibility="Collapsed" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource GlyphDone}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock x:Name="RestorePointMadeText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                   Text="Purge's administrator helper closes when the cleanup and the scan are done." />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="FooterText" Style="{StaticResource SmallSecondary}"
                       Text="Nothing is moved or removed by Purge until you confirm the list on the leftovers page." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
