<?xml version="1.0" encoding="utf-8"?>
<!-- S5: settings. Alpha rule: nothing on screen may pretend (DECISIONS 2026-11-24). The board's safety dial (three
     presets, a live preview, "Pre-select user data") and the planned options (scan after uninstalling, weak matches,
     protected locations, quiet mode, restore point, closing running apps, always start as administrator, knowledge
     packs, licenses) changed nothing in the app, so they are not shown. What is left either works (Theme, Open
     quarantine) or states a fact of this version (what Purge ticks for you, how long the quarantine keeps things,
     the versions). -->
<UserControl
    x:Class="Purge.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource SmallSecondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ExpanderHost" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FactLine" TargetType="TextBlock" BasedOn="{StaticResource Body13}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer AutomationProperties.Name="Settings">
        <StackPanel Padding="28,20,28,32" Spacing="4" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <!-- What the leftovers review ticks for you: the broker's rule, stated, not chosen. -->
            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,4">
                <StackPanel Spacing="8">
                    <TextBlock Text="What Purge ticks for you" Style="{StaticResource RowTitle}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource FactLine}"
                               Text="After an uninstall, Purge ticks only leftovers it rates Safe. Likely items and weak matches wait for your own tick, and Protected items can never be ticked." />
                    <TextBlock Style="{StaticResource FactLine}"
                               Text="When the uninstaller failed or Purge could not check that the program is gone, the scan is a forced one and nothing is ticked." />
                    <TextBlock Style="{StaticResource FactLine}"
                               Text="You see the whole list and confirm it in Purge's security prompt before anything moves. Everything moved can be put back from History &amp; undo." />
                </StackPanel>
            </Border>

            <!-- Quarantine: the plan's retention (ENGINE_PLAN.md §7.8), stated rather than chosen. -->
            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,4">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Quarantine" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="Files are kept 30 days; registry, service and task backups 180 days. When something expires, Purge offers to delete it and asks first; nothing is deleted on its own." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open quarantine" VerticalAlignment="Center" Tag="vault" Click="OnOpenPage" />
                </Grid>
            </Border>

            <!-- Appearance (not in the board; needed to check both themes) -->
            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,4">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Light, dark, or follow Windows" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeChoice" Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
                        <ComboBoxItem Content="Use Windows setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,4">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="AboutLine" Style="{StaticResource RowTitle}" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource RowHint}"
                               Text="Leftover scanners include code ported from Bulk Crap Uninstaller (Apache-2.0)." />
                </StackPanel>
            </Border>

            <!-- Diagnostic builds only (DEBUG): the launch markers of this start. -->
            <Expander x:Name="MarkersExpander" Header="Launch markers (this start)" Style="{StaticResource ExpanderHost}"
                      Visibility="Collapsed">
                <TextBlock x:Name="Markers" Style="{StaticResource Mono}" IsTextSelectionEnabled="True" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
