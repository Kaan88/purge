<?xml version="1.0" encoding="utf-8"?>
<!-- Board 09, Footprint map (hatching is drawn as line geometry: a repeating gradient brush corrupted the
     rendering of the whole region in WinUI 2.6, so it is not used):  each block is a program sized by the disk it holds plus what it is expected to leave
     behind; the hatched band is that expected share. Plain XAML (no Win2D): an ItemsControl over a one-cell Grid with
     each block placed by Margin, laid out by a squarified treemap in code. Every block is a focusable button with a
     full accessible name, and a list view shows the same data as rows. In a contrast theme blocks lose their fills
     and the band is outlined and labelled, so hatching is never the only signal. -->
<UserControl
    x:Class="Purge.App.Views.FootprintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Purge.App.Views">

    <UserControl.Resources>
        <!-- A block: just its content, plus the system focus rectangle for keyboard users. -->
        <Style x:Key="BlockButton" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Padding="28,20,28,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Footprint" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Each block is a program, sized by the disk it holds. The hatched band is what it is expected to leave behind."
                           FontSize="13" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="MapToggle" IsChecked="True" Checked="OnShowMap" Unchecked="OnToggleUnchecked" AutomationProperties.Name="Show as map">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xECA5;" FontSize="14" /><TextBlock Text="Map" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ListToggle" Checked="OnShowList" Unchecked="OnToggleUnchecked" AutomationProperties.Name="Show as list">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="14" /><TextBlock Text="List" /></StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Legend: a swatch plus words for each mark. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" CornerRadius="3" Background="#4A6FA5" BorderBrush="{ThemeResource FootprintOutlineBrush}" BorderThickness="{ThemeResource FootprintOutlineThickness}" />
                <TextBlock Text="Installed files" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1">
                    <Path Data="M0,4 L4,0 M0,9 L9,0 M0,14 L14,0 M5,14 L14,5 M10,14 L14,10" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                </Border>
                <TextBlock FontSize="13" VerticalAlignment="Center"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" /><Run Text=" Expected leftovers" /></TextBlock>
            </StackPanel>
            <TextBlock x:Name="Summary" FontSize="13" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid x:Name="MapHost" SizeChanged="OnMapSizeChanged">
                        <ItemsControl x:Name="Blocks" IsTabStop="False" AutomationProperties.Name="Footprint map">
                            <!-- No entrance animations: the layout is re-applied on every resize. -->
                            <ItemsControl.ItemContainerTransitions><TransitionCollection /></ItemsControl.ItemContainerTransitions>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:FootprintItem">
                                    <Button Style="{StaticResource BlockButton}" Margin="{x:Bind Margin}" Width="{x:Bind Width}" Height="{x:Bind Height}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnBlock"
                                            AutomationProperties.Name="{x:Bind AccessName}" ToolTipService.ToolTip="{x:Bind AccessName}">
                                        <Grid CornerRadius="6" Background="{x:Bind Tile}">
                                            <Border Background="{ThemeResource FootprintCoverBrush}" BorderBrush="{ThemeResource FootprintOutlineBrush}"
                                                    BorderThickness="{ThemeResource FootprintOutlineThickness}" CornerRadius="6" />
                                            <StackPanel Margin="10,8" Visibility="{x:Bind LabelVisibility}">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource FootprintTextBrush}" />
                                                <TextBlock Text="{x:Bind SizeText}" FontSize="12" Foreground="{ThemeResource FootprintTextBrush}" Opacity="0.85" />
                                            </StackPanel>
                                            <!-- Expected leftovers: hatched band at the bottom, with its label and glyph. -->
                                            <Grid Height="{x:Bind BandHeight}" VerticalAlignment="Bottom" Visibility="{x:Bind BandVisibility}">
                                                <Path Data="{x:Bind Hatch}" Stroke="#59FFFFFF" StrokeThickness="2.5" />
                                                <Border BorderBrush="{ThemeResource FootprintOutlineBrush}" BorderThickness="{ThemeResource FootprintOutlineThickness}" CornerRadius="0,0,6,6" />
                                                <TextBlock Margin="10,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource FootprintTextBrush}" Visibility="{x:Bind BandLabelVisibility}">
                                                    <Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" /><Run Text=" " /><Run Text="{x:Bind BandText}" />
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- The same data as rows: the accessible view and the one to use with many small programs. -->
                    <ListView x:Name="Rows" x:Load="False" SelectionMode="Single" SelectionChanged="OnRowSelected"
                              AutomationProperties.Name="Programs by footprint">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FootprintItem">
                                <Grid Height="44" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{x:Bind Tile}">
                                        <TextBlock Text="{x:Bind Initial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <Grid Grid.Column="3" Height="8" VerticalAlignment="Center">
                                        <Rectangle Width="{x:Bind ListBar}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Rectangle Width="{x:Bind ListBand}" Margin="{x:Bind ListBandMargin}" HorizontalAlignment="Left" Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                   Stroke="{ThemeResource FootprintOutlineBrush}" StrokeThickness="1" />
                                    </Grid>
                                    <TextBlock Grid.Column="4" Text="{x:Bind LeftoverText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Details of the chosen program -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border x:Name="DTile" Width="40" Height="40" CornerRadius="8">
                            <TextBlock x:Name="DInitial" Foreground="White" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DName" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Name="DSub" Style="{StaticResource SmallSecondary}" />
                        </StackPanel>
                    </Grid>
                    <Grid RowSpacing="6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Installed files" FontSize="13" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="DSize" Grid.Column="1" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" FontSize="13" Style="{StaticResource SecondaryText}"><Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" /><Run Text=" Expected leftovers" /></TextBlock>
                        <TextBlock x:Name="DLeft" Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="Where it would be" FontWeight="SemiBold" FontSize="13" />
                    <ItemsControl x:Name="DLines">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ExpectLine">
                                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Text}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}" FontSize="12" Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DNote" Style="{StaticResource SmallSecondary}" />
                    <Button x:Name="DUninstall" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnUninstall" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
