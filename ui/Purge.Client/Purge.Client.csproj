<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine client for Purge.App. Today only a stub (FakeEngineClient); the NDJSON JSON-RPC transport over
       stdio / pipe (ENGINE_PLAN.md §3.3) and the NJsonSchema-generated DTOs replace Model/ in M3. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Purge.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fake\sample-inventory.json" LogicalName="Purge.Client.sample-inventory.json" />
    <EmbeddedResource Include="Fake\sample-sizes.json" LogicalName="Purge.Client.sample-sizes.json" />
    <EmbeddedResource Include="Fake\sample-forecast.json" LogicalName="Purge.Client.sample-forecast.json" />
    <EmbeddedResource Include="Fake\sample-quarantine.json" LogicalName="Purge.Client.sample-quarantine.json" />
  </ItemGroup>
</Project>
