{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PurgeResult",
  "description": "`quarantine.purge`.",
  "type": "object",
  "properties": {
    "kept": {
      "description": "Entries kept.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "outcome": {
      "description": "What the purge did.",
      "$ref": "#/$defs/Outcome"
    },
    "purged": {
      "description": "Entries deleted.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "purged_backups": {
      "description": "Of `purged`, the entries that were backups (registry backups and definitions, one entry per\nop) rather than quarantined items. Absent is 0.",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    }
  },
  "required": [
    "outcome",
    "purged",
    "kept"
  ],
  "$defs": {
    "Outcome": {
      "description": "What a run did. Carried by results; not an error.",
      "oneOf": [
        {
          "description": "Everything was done.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Some items are held or failed; the result names them and what holds them.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "An undo restored what it could and lists conflicts.",
          "type": "string",
          "const": "undo_conflicts"
        },
        {
          "description": "The session was not recorded completely; History offers recovery. Wins over the two above.",
          "type": "string",
          "const": "not_closed"
        }
      ]
    }
  }
}
