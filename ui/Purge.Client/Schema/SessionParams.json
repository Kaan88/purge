{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionParams",
  "description": "`{session}`: `history.get`, `journal.resume`, `journal.rollback`, `journal.retry_held`.",
  "type": "object",
  "properties": {
    "session": {
      "description": "The executor session.",
      "$ref": "#/$defs/SessionId"
    }
  },
  "additionalProperties": false,
  "required": [
    "session"
  ],
  "$defs": {
    "SessionId": {
      "description": "UTC start time and 64 random bits, e.g. 20261115T101502Z-9f3a6c1d2b7e4a50",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"
    }
  }
}
