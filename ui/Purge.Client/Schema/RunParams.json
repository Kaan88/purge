{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunParams",
  "description": "`uninstall.run {session_id, quiet}`.",
  "type": "object",
  "properties": {
    "quiet": {
      "description": "Run the quiet uninstall command.",
      "type": "boolean"
    },
    "session_id": {
      "description": "The uninstall session from `uninstall.prepare`.",
      "$ref": "#/$defs/UninstallSessionId"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "quiet"
  ],
  "$defs": {
    "UninstallSessionId": {
      "type": "string",
      "pattern": "^u-[0-9a-f]{16}$"
    }
  }
}
