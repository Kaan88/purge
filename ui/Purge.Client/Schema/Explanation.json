{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explanation",
  "description": "`candidate.explain`.",
  "type": "object",
  "properties": {
    "blockers": {
      "description": "What blocks it, one line each.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_id": {
      "description": "The candidate.",
      "$ref": "#/$defs/CandidateRef"
    },
    "evidence": {
      "description": "The evidence, one line each.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "candidate_id",
    "evidence",
    "blockers"
  ],
  "$defs": {
    "CandidateRef": {
      "type": "string",
      "pattern": "^c-[0-9a-f]{16}$"
    }
  }
}
