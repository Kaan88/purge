* text=auto
# Shell scripts run under bash; CRLF breaks them.
*.sh text eol=lf
*.tsv.gz binary
# xtask gen-dto writes LF and --check compares bytes.
ui/Purge.Client/Schema/*.json text eol=lf
ui/Purge.Client/Generated/*.cs text eol=lf
# BL-GATE: the L3 reference plans and the self-test fixtures are compared by SHA-256 and byte for byte.
vm/truth/baseline-local/l3-ref/*.json -text
vm/truth/fixtures/bl/** -text
# xtask notices writes LF; --check compares after normalising line ends, the installer ships this file.
THIRD-PARTY-NOTICES.txt text eol=lf
tools/xtask/src/notices/** text eol=lf
